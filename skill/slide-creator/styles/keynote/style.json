{
  "name": "keynote",
  "label": "Keynote",
  "summary": "Dark-first, large-type talks with one idea per slide, broad colour fields and very little chrome.",
  "bestFor": [
    "town halls and keynote talks",
    "big announcements",
    "presentations delivered live"
  ],
  "schemes": {
    "default": {
      "bg": "#0C1021",
