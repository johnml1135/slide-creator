  "type": {
    "heading": {
      "family": [
        "Aptos Display",
        "Aptos",
        "Segoe UI",
        "Arial",
        "sans-serif"
      ],
      "weight": 700,
      "tracking": "-0.025em",
      "case": "none"
    },
    "body": {
      "family": [
        "Aptos",
        "Segoe UI",
        "Arial",
        "sans-serif"
      ],
      "weight": 400
    },
    "mono": {
      "family": [
        "Cascadia Mono",
        "Consolas",
        "Menlo",
        "monospace"
      ]
    },
    "label": {
      "font": "body",
      "weight": 600,
      "tracking": "0.08em",
      "case": "uppercase"
    },
    "scale": {
      "display": 104,
      "h1": 72,
      "h2": 52,
      "h3": 36,
      "body": 32,
      "small": 24,
      "caption": 18,
      "label": 17
    },
    "lineHeight": {
      "tight": 1.04,
      "body": 1.3
    },
    "measure": "40em"
  },
  "space": {
    "unit": 8,
    "margin": [
      88,
      96,
      88,
      96
    ],
    "gutter": 44,
    "safe": 36
  },
  "shape": {
    "radius": 0,
    "radiusLarge": 0,
    "rule": 1,
    "ruleStrong": 3,
    "shadow": "none"
  },
  "diagram": {
    "layoutEngine": "elk",
    "pad": 24,
    "fontSize": 17,
    "stroke": 1,
    "radius": 4,
    "nodeFill": "surface",
    "nodeStroke": "rule",
    "groupStroke": "rule",
    "sketch": false,
    "labelCase": "Sentence case"
  },
  "chart": {
    "grid": "y",
    "fontSize": 14,
    "barRadius": 0,
    "lineWidth": 2.5,
    "emphasis": "primary",
    "deemphasis": "rule"
  },
  "rules": {
    "maxWords": 50,
    "maxBullets": 5,
    "maxAccentsPerSlide": 2,
    "minFontPx": 15,
    "titleStyle": "phrase",
    "photos": "only one purposeful full-bleed image",
    "icons": "very few; support a label only"
  },
  "samples": {
    "example": "showcase",
    "reference": [
      1,
      3,
      4,
