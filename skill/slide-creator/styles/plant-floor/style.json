  "type": {
    "heading": { "family": ["Bahnschrift", "DIN Alternate", "Roboto Condensed", "Arial Narrow", "Segoe UI", "sans-serif"], "weight": 600, "tracking": "0", "case": "none" },
    "body": { "family": ["Segoe UI", "Aptos", "Roboto", "Arial", "sans-serif"], "weight": 400 },
    "mono": { "family": ["Cascadia Mono", "Consolas", "Roboto Mono", "Menlo", "monospace"] },
    "label": { "font": "mono", "weight": 600, "tracking": "0.06em", "case": "uppercase" },
    "scale": { "display": 72, "h1": 54, "h2": 36, "h3": 23, "body": 23, "small": 19, "caption": 15, "label": 15 },
    "lineHeight": { "tight": 1.1, "body": 1.45 },
    "measure": "38em"
  },
  "space": { "unit": 8, "margin": [104, 64, 80, 64], "gutter": 40, "safe": 28 },
  "shape": { "radius": 2, "radiusLarge": 2, "rule": 2, "ruleStrong": 4, "shadow": "none" },
  "diagram": {
    "layoutEngine": "elk",
    "pad": 24,
    "fontSize": 17,
    "stroke": 2,
    "radius": 2,
    "nodeFill": "bg",
    "groupStroke": "muted",
    "groupDash": 0,
    "sketch": false,
    "monoLabels": true,
    "labelCase": "Sentence case; equipment tags and IDs in monospace (e.g. L4-PRESS-02)"
  },
  "chart": { "grid": "both", "fontSize": 14, "barRadius": 0, "lineWidth": 2.5, "emphasis": "accent", "deemphasis": "muted" },
  "rules": {
    "maxWords": 60,
    "maxBullets": 6,
    "maxAccentsPerSlide": 3,
    "minFontPx": 13,
    "titleStyle": "phrase",
    "photos": "real equipment, line and site photos; annotated with numbered callouts",
    "icons": "functional only (safety, equipment, status); solid single colour"
  }
