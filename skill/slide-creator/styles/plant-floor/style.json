{
  "name": "plant-floor",
  "label": "Plant Floor",
  "summary": "Industrial / engineering style: high contrast, condensed DIN-like headings, numbered sections, monospace labels, square corners and the familiar safety colour language (red stop, amber caution, green OK, blue info). Built for operations, process and engineering content.",
  "bestFor": ["operations and production reviews", "continuous improvement (A3, kaizen, root cause)", "engineering and process documentation", "project status, schedules and readiness checks", "shop-floor screens (use the dark scheme)"],
  "schemes": {
    "default": {
      "bg": "#F5F5F2",
