      "ink": "#111418",
      "muted": "#565B63",
      "rule": "#C4C6C2",
      "primary": "#1E2833",
      "accent": "#F2A900",
      "good": "#2E8540",
      "warn": "#F2A900",
      "bad": "#C8102E",
      "info": "#005EB8",
      "categorical": ["#1E2833", "#F2A900", "#005EB8", "#7A8089", "#2E8540", "#C8102E"],
      "sequential": ["#E7E7E2", "#1E2833"]
    },
    "dark": {
      "bg": "#111418",
      "surface": "#1D2229",
      "ink": "#F2F3F1",
      "muted": "#9AA0A8",
      "rule": "#353C45",
      "primary": "#2A3440",
      "accent": "#FFC020",
      "good": "#4CC069",
      "warn": "#FFC020",
      "bad": "#FF4D5E",
      "info": "#4DA3FF",
      "categorical": ["#F2F3F1", "#FFC020", "#4DA3FF", "#9AA0A8", "#4CC069", "#FF4D5E"],
      "sequential": ["#1D2229", "#FFC020"]
    }
